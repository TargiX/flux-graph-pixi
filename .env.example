# Local app origin used by billing redirects and local smoke/debug flows.
NEXT_PUBLIC_APP_URL=http://localhost:3050

# Public support contact shown on the landing page, rooms console, and privacy page.
NEXT_PUBLIC_ROOMBOARD_SUPPORT_EMAIL=support@roomboard.online

# Phoenix realtime sidecar. Use the same secret in Next and Phoenix.
NEXT_PUBLIC_ROOMBOARD_REALTIME_URL=http://localhost:4001
ROOMBOARD_REALTIME_SECRET=replace-with-the-same-random-secret-in-next-and-phoenix

# Supabase room persistence and private upload storage.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
ROOMBOARD_SUPABASE_TABLE=roomboard_rooms
ROOMBOARD_UPLOAD_BUCKET=roomboard-uploads

# Production should leave the server fallback disabled unless you intentionally run a short emergency cohort.
# ROOMBOARD_ALLOW_SERVER_REALTIME_FALLBACK=true
# NEXT_PUBLIC_ROOMBOARD_ALLOW_SERVER_FALLBACK=true
