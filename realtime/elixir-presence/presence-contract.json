{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Roomboard Presence Snapshot",
  "type": "object",
  "required": ["id", "name", "color", "focus", "x", "y", "updatedAt"],
  "properties": {
    "id": { "type": "string" },
    "name": { "type": "string", "maxLength": 24 },
    "color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
    "focus": { "type": "string" },
    "x": { "type": "number" },
    "y": { "type": "number" },
    "updatedAt": { "type": "number" }
  }
}
